{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "projectRoot": "./artifacts/yatra-guard",
      "env": {
        "EXPO_PUBLIC_DOMAIN": "yatraguard-api.onrender.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "projectRoot": "./artifacts/yatra-guard",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "yatraguard-api.onrender.com"
      }
    },
    "production": {
      "projectRoot": "./artifacts/yatra-guard",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_DOMAIN": "yatraguard-api.onrender.com"
      }
    }
  },
  "submit": {
    "production": {}
  }
}

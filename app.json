{
  "expo": {
    "name": "YatraGuard",
    "slug": "yatra-guard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./artifacts/yatra-guard/assets/images/icon.png",
    "scheme": "yatra-guard",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./artifacts/yatra-guard/assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.yatraguard.app",
      "adaptiveIcon": {
        "foregroundImage": "./artifacts/yatra-guard/assets/images/icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./artifacts/yatra-guard/assets/images/icon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {}
    },
    "owner": "krishna_313"
  }
}
